# ==============================================================================
# Konfigurace BankApp Inspector
# ==============================================================================

# Port, na kterém aplikace naslouchá na hostitelském serveru (lze změnit např. na 8088)
HOST_PORT=8087

# Port uvnitř kontejneru (výchozí pro Nginx je 80)
PORT=80

# Název Docker kontejneru
CONTAINER_NAME=bankapp-inspector

# Časové pásmo kontejneru
TZ=Europe/Prague
